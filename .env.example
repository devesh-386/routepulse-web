# CARTO basemap tiles need a key (without one they show an "API KEY REQUIRED" watermark).
# Public by nature (sent with every tile request), so restrict it to your domains in CARTO.
# NEXT_PUBLIC_CARTO_KEY=

# Optional AI explanations through any free OpenAI-compatible provider.
# Leave LLM_BASE_URL unset to run on validated template answers only (the default).
# Copy to .env.local for local dev, or set the same names in Vercel → Project → Settings → Environment Variables.
# Model names below were current when written; check each provider's free-model list.
# Every AI answer is checked against the evidence; anything that fails falls back to the template.

# Groq free tier (key from https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Google Gemini free tier, OpenAI-compatible endpoint (key from https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=

# OpenRouter free models (pick any model id ending in :free)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# LLM_API_KEY=

# Local Ollama, no key, local dev only (a deployed site cannot reach your machine)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Google Maps basemap + live traffic in the control room (optional). Needs the "Map Tiles API" enabled on a
# Google Cloud project with billing. The key is sent to the browser with every tile request, so restrict it to
# your domains (HTTP referrers) and to the Map Tiles API. Without it the control room uses the free basemap.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
